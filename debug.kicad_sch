	(text_box "Design Note:\nConnector is 2.54mm pitch pin header.\nDesigned for usage with FTDI TTL UART Cable\nsuch as TTL-232R-3V3"
		(exclude_from_sim no)
		(at 220.98 54.61 0)
		(size 52.07 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width -0.0001)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a0217c9a-5f3c-4764-bf3d-ad73cf7fb228")
	)
	(text_box "Design Note:\nConnector is 1.27mm pitch shrouded/keyed pin header.\nMatches the ARM Cortex Debug Connector (10-pin), same as netdaq.\nSWD only: TDO (pin 6) and TDI (pin 8) are not connected,\nbecause PB3/PA15 are SPINDLE_B/SPINDLE_A."
		(exclude_from_sim no)
		(at 200.66 130.81 0)
		(size 52.07 16.2161)
		(margins 0.9525 0.9525 0.9525 0.9525)
