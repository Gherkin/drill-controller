	)
	(text "Layout: put C25 (1 µF) and C24 (100 nF) right at U4, not at J4 (#87). Short traces to\nU4 pin 11 (VDD) and pin 12 (VDD3V3), shortest return to U4 pin 13 (GND) on GND_SNS.\nD60 p9: the 1 µF must be \"located close to the chip for decoupling\".\nThe supply comes over the cable (#47), so these caps are the only low-impedance source at U4."
		(exclude_from_sim no)
		(at 149.86 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
